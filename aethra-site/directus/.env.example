# Written for you by `npm run directus:init`. Never commit the real .env.
HOST=127.0.0.1
PORT=8055
PUBLIC_URL=https://your-domain/admin2
SECRET=<random 64 hex characters>
DB_CLIENT=sqlite3
DB_FILENAME=./data/directus.db
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=<random>
TELEMETRY=false
WEBSOCKETS_ENABLED=false
CORS_ENABLED=false
STORAGE_LOCATIONS=local
STORAGE_LOCAL_ROOT=./data/uploads
EXTENSIONS_PATH=./extensions
# Added by `npm run directus:setup`: read-only token the website uses with CONTENT_SOURCE=directus
# SITE_READER_TOKEN=
