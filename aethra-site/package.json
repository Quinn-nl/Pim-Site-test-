{
  "name": "aethra-site",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Aethra with its own CMS (SQLite, Node.js built-ins only). No runtime dependencies.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "seo": "node scripts/seo-audit.cjs",
    "seo:baseline": "node scripts/seo-audit.cjs --baseline",
    "seo:compare": "node scripts/seo-audit.cjs --compare",
    "indexnow": "node scripts/indexnow.cjs",
    "restore": "node scripts/restore.js",
    "backup": "node scripts/backup.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/admin.e2e.cjs",
    "user:create": "node scripts/user.js create",
    "user:password": "node scripts/user.js password",
    "user:reset-2fa": "node scripts/user.js reset-2fa",
    "user:list": "node scripts/user.js list"
  }
}
